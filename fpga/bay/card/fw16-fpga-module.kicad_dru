(version 1)
(rule "PCIe stripline on L3"
  (layer "In2.Cu")
  (condition "A.NetClass == 'PCIe'")
  (constraint track_width (min 0.09mm) (opt 0.15mm))
  (constraint diff_pair_gap (min 0.09mm) (opt 0.10mm)))
(rule "PCIe 3W spacing outside U14 and J1"
  (condition "A.NetClass == 'PCIe' && !A.isCoupledDiffPair() && !A.intersectsCourtyard('U14') && !A.intersectsCourtyard('J1')")
  (constraint clearance (min 0.3mm)))